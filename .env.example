# Copie este arquivo como .env.local e preencha com os dados do projeto "mcjuridico" no Supabase
# (Supabase > Project Settings > API). Pode usar a "anon key" ou a "publishable key".
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=COLE-A-CHAVE-AQUI

# Endereço final do site (use o domínio quando tiver; enquanto isso, o link da Vercel)
NEXT_PUBLIC_SITE_URL=https://mcjuridico.vercel.app
