# Copie este arquivo como .env.local e preencha com os dados do projeto "mcjuridico" no Supabase
# (Supabase > Project Settings > API). Pode usar a "anon key" ou a "publishable key".
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=COLE-A-CHAVE-AQUI

# Endereço final do site (use o domínio quando tiver; enquanto isso, o link da Vercel)
NEXT_PUBLIC_SITE_URL=https://mcjuridico.vercel.app


# Atualização 17 — notificações no celular do cliente e lembrete automático (opcional).
# As chaves já foram geradas no arquivo .env.notificacoes.local (fora do GitHub).
# Para gerar outras: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTATO=mailto:seu-email@exemplo.com.br
# Mesmo valor do "Código do lembrete" em Painel > Master > Notificações
CRON_SECRET=
