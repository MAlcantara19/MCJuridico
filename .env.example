# Copie este arquivo como .env.local e preencha com os dados do projeto "mcjuridico" no Supabase
# (Supabase > Project Settings > API). Pode usar a "anon key" ou a "publishable key".
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=COLE-A-CHAVE-AQUI

# Endereço final do site (use o domínio quando tiver; enquanto isso, o link da Vercel)
NEXT_PUBLIC_SITE_URL=https://mcjuridico.vercel.app

# ---------- Lembrete diário por e-mail (opcional) ----------
# Supabase > Project Settings > API > service_role (ou "secret key"). NUNCA coloque NEXT_PUBLIC na frente desta.
SUPABASE_SERVICE_ROLE_KEY=COLE-A-CHAVE-SERVICE-ROLE
# resend.com > API Keys (plano grátis)
RESEND_API_KEY=re_xxxxxxxx
# E-mail que recebe o lembrete (o mesmo usado para criar a conta no Resend)
LEMBRETE_EMAIL=email-dela@gmail.com
# Senha qualquer, longa, inventada por você (a Vercel usa para chamar o lembrete)
CRON_SECRET=invente-uma-senha-longa-aqui
